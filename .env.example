# Environment variables for Talqa Net (طلقة نت)

# Server-side Gemini API Key (if utilized)
GEMINI_API_KEY=

# HMR Control (managed by AI Studio)
DISABLE_HMR=true

# Firebase Integration (Cloud Firestore & Auth - Project: talqanet-cf3e1)
# Leave empty to run with zero-config Bundled Static Seed Repository
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=talqanet-cf3e1.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=talqanet-cf3e1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=talqanet-cf3e1.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
