rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // المحتوى العام (الباقات، نقاط التوزيع، الإعلانات، القنوات، عناصر الاستراحة، الإعدادات)
    // القراءة متاحة للجميع (مشتركي الشبكة أوفلاين وأونلاين)
    // الكتابة محصورة بمسؤولي النظام المسجلين
    match /packages/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /distributors/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /channels/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /lounge_items/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // مسابقة الولاء وصندوق الجوائز (المرحلة 3)
    // الكروت المستهلكة: التحقق من عدم التكرار
    match /consumed_vouchers/{voucherCode} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.voucherCode == voucherCode;
      allow update, delete: if false; // لا يمكن تعديل أو حذف كرت مستهلك
    }

    // صندوق الجوائز: حماية الكروت الرابحة (قراءة وتعديل من السيرفر/المشرف فقط)
    match /reward_vault/{rewardId} {
      allow read, write: if request.auth != null;
    }

    // سجل المطالبات والجوائز الممنوحة
    match /reward_claims/{claimId} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.claimId == claimId;
      allow update, delete: if false;
    }
  }
}
